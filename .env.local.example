# Google Maps API Key (required for real data)
# Get one at https://console.cloud.google.com/apis/library/maps-backend.googleapis.com
# Enable: Maps JavaScript API + Places API (New) + Routes API
# Restrict the key to your domain(s) + specific APIs in production
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# For local testing you can leave this and use mock data mode in the app
